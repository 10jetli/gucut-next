#!/bin/bash
# ด่านก่อน push — ติดตั้งด้วย scripts/install-pre-push.sh
#
# 🔴 **อำนาจสองระดับ — ห้ามสลับลำดับ** (แก้ 19 ก.ย. 2569 · ฝั่งท่อเจอช่องโหว่นี้ก่อนแล้วบอกมา)
#   ① **วันหยุด deploy = คำสั่งท่านประธาน** ⇒ ข้ามด้วยตัวแปรของเราไม่ได้
#   ② **ด่านทดสอบ = ของเราเอง** ⇒ ข้ามได้ด้วย SKIP_PREPUSH=1
#   ⚠️ ของเดิมเช็ค `SKIP_PREPUSH` **ก่อน** วันหยุด ⇒ `SKIP_PREPUSH=1 git push`
#      ข้ามคำสั่งท่านได้ด้วยตัวแปรเดียว · ไม่มีใครตั้งใจให้เป็นแบบนั้น มันเป็นแค่ลำดับบรรทัด
#   🔑 บทเรียน: **ลำดับของการเช็ค คือการมอบอำนาจ** — ตัวที่เช็คก่อน มีอำนาจเหนือตัวที่เช็คทีหลัง
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0

# ── ⏱️ **จดเวลาที่ด่านนี้ใช้ และเตือนตั้งแต่ต้นว่าอาจวิ่งไม่ทันหน้าต่าง push** ──
# 🔴 ที่มา 28 ก.ย. 2569 (วัดของจริงคืนนี้): ยิง push ตอน 21:37 ซึ่งอยู่ในหน้าต่าง 20:30-22:00
#    ด่านนี้รันเทส+build ไป **1 ชม. 22 นาที** ⇒ ของขึ้นเว็บจริงตอน 22:59 = เลยหน้าต่างเกือบชั่วโมง
# 🔑 เหตุ: หน้าต่างถูกบังคับที่ **ด่านคำสั่ง bash ตอนพิมพ์คำสั่ง** ที่เดียว
#    ⇒ "ยิงตอน 21:59 = deploy ตอนเที่ยงคืน" โดยไม่มีอะไรฟ้อง
#    ⇒ คลาสเดียวกับที่ไล่กันทั้งวัน: **ตัวคุมวัดผิดจังหวะ — วัดตอนเริ่ม ทั้งที่ของที่ต้องคุมคือตอนเกิดผล**
# 🚫 **ไม่ตีกลับ** (ฝั่งท่อตัดสิน 28 ก.ย.): ตีกลับหลังทำงานไปชั่วโมงหนึ่งไม่ประหยัดเครดิตสักหน่วย
#    เพราะยังเป็น deploy รอบเดียวเท่ากัน · และมีแต่จะผลักคนไปใช้ทางฉุกเฉิน = ได้ deploy เพิ่ม
#    ⇒ ขั้นนี้ทำสองอย่าง: **เตือนตั้งแต่ต้นด้วยตัวเลขจริง** และ **จดของจริงไว้**
PREPUSH_T0=$(date +%s)
PREPUSH_LOG="$HOME/.gucut-prepush-เวลา.log"
PREPUSH_REPO="$(basename "$(pwd)")"
# ⚠️ ขอบหน้าต่าง **อ่านจากด่านคำสั่ง bash** ไม่พิมพ์เลขซ้ำ — เกณฑ์เดียวต้องมีแหล่งเดียว
PREPUSH_GATE="$HOME/claude-shared/ด่านคำสั่ง-bash.py"
PREPUSH_WIN=$(grep -m1 '^PUSH_WINDOW' "$PREPUSH_GATE" 2>/dev/null \
  | grep -oE '[0-9]+' | tr '\n' ' ' | awk '{ if (NF>=4) printf "%d %d", $1*60+$2, $3*60+$4 }')
PREPUSH_MIN0=$(( 10#$(date +%H) * 60 + 10#$(date +%M) ))
PREPUSH_INWIN0=""
if [ -n "$PREPUSH_WIN" ]; then
  PREPUSH_LO=${PREPUSH_WIN%% *}; PREPUSH_HI=${PREPUSH_WIN##* }
  if [ "$PREPUSH_MIN0" -ge "$PREPUSH_LO" ] && [ "$PREPUSH_MIN0" -le "$PREPUSH_HI" ]; then
    PREPUSH_INWIN0=1
    PREPUSH_LEFT=$(( PREPUSH_HI - PREPUSH_MIN0 ))
    # 🔑 **นับเฉพาะแถวของรีโปนี้** — สมุดเป็นไฟล์กลางที่สองรีโปเขียนร่วมกัน
    #    ด่านของสองฝั่งใช้เวลาต่างกันมาก ⇒ เอามารวมกันแล้วคาดเวลา = เตือนผิดทั้งสองฝั่ง
    #    (กฎเดิมของเรา: เทียบเลขต้องวัดรุ่นเดียวกัน · แถวของอีกฝั่งไม่ใช่ประวัติของด่านนี้)
    # 🔴 **เทียบเต็มช่อง ห้ามเทียบแบบมีคำนั้นอยู่** (ฝั่งท่อยิงวัดแล้วจับได้ 28 ก.ย. 2569)
    #    รุ่นแรกผมใช้ `$0 ~ repo` ซึ่งเป็น **substring** ⇒ สมุดที่มีแถว `gucut-web-สำรอง`
    #    จะถูกนับรวมตอนกรองหา `gucut-web` ⇒ ได้ค่านานสุดผิด (เขาวัดได้ 150 นาที ทั้งที่จริง 25)
    #    ⇒ คลาสเดียวกับรู prefix ของ middleware ที่ปิดไปเมื่อเช้า: **ขึ้นต้นเหมือนกัน ≠ ตัวเดียวกัน**
    PREPUSH_WORST=$(awk -v repo="$PREPUSH_REPO" \
      '$2 == repo { for (i = 1; i <= NF; i++) if ($i == "ใช้") { s = $(i+1) + 0; if (s > m) m = s } }
       END { print m + 0 }' "$PREPUSH_LOG" 2>/dev/null)
    if [ "${PREPUSH_WORST:-0}" -gt 0 ]; then
      echo "⏱️  ด่านของรีโปนี้เคยใช้นานสุด $(( PREPUSH_WORST / 60 )) นาที · หน้าต่าง push ปิดอีก $PREPUSH_LEFT นาที"
      if [ $(( PREPUSH_WORST / 60 )) -gt "$PREPUSH_LEFT" ]; then
        echo "   ⚠️ **อาจวิ่งไม่ทันหน้าต่าง** — ของจะขึ้นเว็บนอกรอบ (ไม่ถูกตีกลับ แต่ถูกจด)"
        echo "      กด Ctrl-C ตอนนี้ยังทันถ้าอยากเลื่อนไปรอบหน้า"
      fi
    else
      echo "⏱️  ยังไม่มีประวัติเวลาของด่านในรีโปนี้ ⇒ **คาดเวลาเสร็จไม่ได้** (รอบนี้จะเป็นข้อมูลแรก)"
    fi
  else
    PREPUSH_INWIN0=0
  fi
else
  # 🔑 อ่านขอบไม่ออก ⇒ **"ยังไม่รู้" ไม่ใช่ "อยู่ในหน้าต่าง"** ⇒ ไม่พูดเรื่องหน้าต่างรอบนั้น
  echo "ℹ️ อ่านขอบหน้าต่าง push จากด่านคำสั่งไม่ได้ ⇒ ไม่ประเมินเรื่องหน้าต่างรอบนี้ (ยังไม่รู้ ไม่ใช่ผ่าน)"
fi

# ── 🧊 ① วันหยุด deploy (คำสั่งท่านประธาน) — ต้องอยู่บนสุดเสมอ ──
# ทุกครั้งที่ push = สร้างเว็บใหม่ = เครดิต · deploy กิน 92% ของทั้งหมด
FREEZE="$HOME/.gucut-deploy-freeze"
FREEZE_LOG="$HOME/.gucut-deploy-freeze.log"
if [ -f "$FREEZE" ]; then
  if [ -n "${CHAIRMAN_APPROVED_PUSH:-}" ]; then
    # 🚫 **การตั้งตัวแปรนี้เองเมื่อท่านไม่ได้สั่ง คือการปลอมคำสั่ง ไม่ใช่การข้ามด่าน**
    #    เขียนไว้ตรง ๆ เพื่อไม่ให้ใครอ่านว่าเป็นทางลัดที่ใช้ได้ · และถูกจดทุกครั้ง
    printf '%s | %s | %s\n' "$(date '+%F %H:%M:%S')" "gucut-next" "${CHAIRMAN_APPROVED_PUSH}" >> "$FREEZE_LOG"
    echo "⚠️  ข้ามวันหยุด deploy โดยอ้างคำสั่งท่านประธาน: ${CHAIRMAN_APPROVED_PUSH}"
    echo "   จดลงแฟ้มบันทึกแล้ว: $FREEZE_LOG"
  else
    echo "🧊 กำลังหยุด deploy อยู่ — ไม่ push"
    sed "s/^/   /" "$FREEZE"
    echo "   งานที่ทำเสร็จให้ commit เก็บไว้ในเครื่องก่อน แล้ว push รวมรอบเดียวตอนเลิกหยุด"
    echo ""
    echo "   🚫 SKIP_PREPUSH=1 **ข้ามข้อนี้ไม่ได้** — เป็นคำสั่งท่านประธาน ไม่ใช่ด่านของเรา"
    echo "   ถ้าท่านสั่งให้ push จริง: CHAIRMAN_APPROVED_PUSH='<คำสั่งของท่าน>' git push"
    exit 1
  fi
fi

# ── ② ด่านทดสอบของเราเอง — ข้ามได้ (ใช้เมื่อจำเป็นจริง ๆ และรู้ว่าทำอะไรอยู่) ──
[ "${SKIP_PREPUSH:-}" = "1" ] && { echo "⏭  ข้ามด่านทดสอบตามที่สั่ง (วันหยุด deploy ตรวจไปแล้วข้างบน)"; exit 0; }

echo "🚦 ด่านก่อน push — กัน build พังไม่ให้เผาเครดิต"

# ── หา node ที่รันชุดทดสอบได้ (ต้อง >= 20.18 เพราะ --experimental-test-module-mocks) ──
# ⚠️ เครื่อง CEO เป็น node 20.15 ซึ่งรันไม่ได้ ⇒ **เคยมองไม่เห็นผลทดสอบจริงมาตลอด**
#    ของที่รันไม่ได้ ห้ามถือว่า "ผ่าน" (กฎ three-states-not-two)
pick_node() {
  for c in "$NODE_FOR_TESTS" node /opt/homebrew/bin/node /usr/local/bin/node \
           "$HOME"/.nvm/versions/node/*/bin/node /private/tmp/claude-*/*/*/scratchpad/nodenew/bin/node; do
    [ -x "$c" ] || command -v "$c" >/dev/null 2>&1 || continue
    v=$("$c" -p "process.versions.node" 2>/dev/null) || continue
    maj=${v%%.*}; rest=${v#*.}; min=${rest%%.*}
    if [ "${maj:-0}" -gt 20 ] || { [ "${maj:-0}" -eq 20 ] && [ "${min:-0}" -ge 18 ]; }; then
      echo "$c"; return 0
    fi
  done
  return 1
}
NODE_FOR_TESTS="${NODE_FOR_TESTS:-}"
N="$(pick_node)" || {
  echo "❌ ไม่พบ node ที่รันชุดทดสอบได้ (ต้อง >= 20.18)"
  echo "   ของที่รันไม่ได้ ห้ามถือว่าผ่าน — ติดตั้ง node ใหม่ หรือตั้ง NODE_FOR_TESTS=/path/to/node"
  echo "   ถ้าจำเป็นจริง ๆ: SKIP_PREPUSH=1 git push"
  exit 1
}

echo "   node ที่ใช้ทดสอบ: $("$N" -v)"
# ── 🔒 ล็อกของหลักฐาน + จับอินพุตที่เปลี่ยนกลางทาง (เพิ่ม 27 ก.ย. 2569) ──
# 🔴 **ของจริงที่เกิดวันนี้ ทั้งสองข้อในการ push ครั้งเดียว**
#   ① `/tmp/prepush-build.log` เป็น **พาธร่วมของสองรีโป** (ฝั่งจอกับฝั่งท่อ/หน้าร้าน)
#      ⇒ ตอน push ของเราล้มแล้วเปิดอ่านหาเหตุ **เนื้อในเป็น build ของอีกรีโป**
#      ⇒ ข้อความอธิบายเหตุของ hook เรา **ชี้ไปที่งานของคนอื่น**
#      🔑 เครื่องมือสองตัวที่เขียนไฟล์ชั่วคราวพาธเดียวกัน จะทำลายหลักฐานของกันและกัน
#         **เฉพาะตอนที่เราต้องการมันที่สุด — คือตอนล้มพร้อมกัน** และไม่มีอะไรฟ้อง
#   ② เราสองบัญชีใช้ **clone เดียวกัน** ⇒ อีกฝั่ง commit ลงกลาง build ของเราได้
#      วันนี้: commit เข้ามา 12:37:36 · build ในhook ล้ม 12:38:22 (ห่าง 46 วิ)
#      ⇒ อาการที่โผล่ **ไม่ใช่ "อินพุตเปลี่ยน" แต่เป็น "ด่านตก"** ซึ่งอ่านเหมือนโค้ดผิด
#      ⇒ กันการชนไม่ได้ (คนละกระบวนการ) แต่ **ห้ามให้ผลที่เชื่อถือไม่ได้ถูกอ่านว่าโค้ดผิด**
REPO_NAME="$(basename "$(git rev-parse --show-toplevel)")"
LOGDIR="/tmp/prepush-$REPO_NAME"
mkdir -p "$LOGDIR"
BUILD_LOG="$LOGDIR/build.log"
# ลายนิ้วมือของสิ่งที่กำลังจะถูก build: HEAD + สภาพไฟล์ทั้งหมด (รวมที่ยังไม่ commit)
ลายนิ้วมือ() { printf '%s|%s' "$(git rev-parse HEAD)" "$(git status --porcelain | md5sum | cut -d" " -f1)"; }
TREE_BEFORE="$(ลายนิ้วมือ)"
# 🔴 **จดแรมว่างตอนเริ่ม — ของจริง 27 ก.ย. 2569 เย็น**
#    g1 เหลือแรมใช้ได้ ~1 GB จาก 23 GB เพราะ `ollama llama-server` ถือ ~13 GB
#    ⇒ `npm run build` ถูกฆ่ากลางทางได้ และ **อาการจะโผล่เป็น "ด่านตก" ไม่ใช่ "แรมหมด"**
#    ⇒ คนอ่านจะไปไล่หาบั๊กในโค้ดที่ไม่มีบั๊ก (คลาสเดียวกับอินพุตเปลี่ยนกลางทาง)
#    ⚠️ เกณฑ์ปรับได้เพื่อ **ให้ระวังขึ้น** เท่านั้น — ตั้งต่ำลงเพื่อเงียบคำเตือนคือการโกหกตัวเอง
MEM_MIN_MB="${PREPUSH_MEM_MIN_MB:-2048}"
MEM_FREE_MB="$(free -m | awk 'NR==2{print $7}')"

if ! "$N" --experimental-test-module-mocks --test scripts/tests/*.test.mjs > $LOGDIR/test.log 2>&1; then
  echo "❌ ชุดทดสอบไม่ผ่าน — ไม่ push"
  grep -E "^# (tests|pass|fail)|^not ok" $LOGDIR/test.log | head -12
  echo "   (ผลเต็มที่ $LOGDIR/test.log)"
  exit 1
fi
grep -E "^# (tests|pass|fail)" $LOGDIR/test.log | sed 's/^/   /'

# ── 🔴 build เต็ม — **"เทสผ่าน" ไม่ใช่ "build ผ่าน"** (เพิ่ม 19 ก.ย. 2569) ──
#    ฝั่งท่อเจอกับตัวเองวันนี้: build ตกเงียบมา 3 commit เพราะชุดทดสอบ
#    **ไม่ครอบสคริปต์ที่รันตอน build เลย** ⇒ เขารายงานเลขเทสทุกรอบ แต่ build แดงอยู่
#    ⇒ ด่านนี้ก็มีรูเดียวกัน: รันแค่ scripts/tests/*.test.mjs
#      ⇒ **ด่าน ~40 ตัวใน prebuild ไม่เคยถูกกระตุ้นตอน push**
#    ⚠️ วันนี้รอดเพราะผมรัน `npm run build` เองก่อน commit ทุกครั้ง
#      ⇒ นั่นคือ **ความตั้งใจ ไม่ใช่กลไก** — และบทเรียนทั้งวันคือความตั้งใจไม่รอด
#
#    💰 ทำไมคุ้มแม้ build จะกินเวลา ~2 นาที:
#       push ถูกจำกัดที่ 45 นาทีต่อครั้งอยู่แล้ว ⇒ ช้าขึ้น 2 นาทีไม่กระทบอะไร
#       แต่ **push ที่ prebuild แดง = Netlify build ตกทั้งรอบ = เครดิตหายฟรี**
#       ⇒ จ่าย 2 นาทีในเครื่อง เพื่อไม่จ่ายเครดิตของร้าน

if ! npm run build > "$BUILD_LOG" 2>&1; then
  echo "❌ build ไม่ผ่าน — ไม่ push (ถ้าปล่อยไป Netlify จะตกทั้งรอบและเสียเครดิตฟรี)"
  # 🔴 **ห้าม grep `🔴`** — ด่านที่ **ผ่าน** ก็พิมพ์ 🔴 เป็นหัวข้อของเคสทดสอบ
  #    รอบแรกที่ลองจริง บรรทัดสรุปจึงเต็มไปด้วยเคสที่ผ่าน และ **สาเหตุจริงไม่โผล่เลย**
  #    ⇒ ท้ายล็อกคือที่ที่ด่านตัวที่ตกพิมพ์ไว้เสมอ (สคริปต์หยุดตรงนั้น) ⇒ พิมพ์ท้ายล็อกด้วยทุกครั้ง
  # 🔴 **ชื่อตัวแปรต้องเป็น ASCII** — รอบแรกผมเขียน `ร่องรอยถูกฆ่า=` แล้ว `bash -n` ผ่าน
  #    (ตรวจแค่ไวยากรณ์) แต่ตอนรันจริงจะได้ `bad substitution` แล้ว **bash เดินต่อ**
  #    ⇒ ตาข่ายนี้จะเงียบตลอดกาลโดยไม่มีอะไรฟ้อง · ทีมเหยียบคลาสนี้มาแล้วหลายครั้ง
  # ── ตาข่ายแรม: ล้มตอนแรมน้อย หรือมีร่องรอยถูกฆ่า ⇒ ผลนี้ตัดสินโค้ดไม่ได้ ──
  # (ฝั่งท่อใส่ตาข่ายแบบเดียวกันไว้แล้ว — ทำให้เท่ากันทั้งสองรีโป 27 ก.ย. 2569)
  # ⚠️ **ห้ามเติม `|| echo 0`** — `grep -c` พิมพ์ `0` อยู่แล้วตอนไม่เจอ แล้ว exit 1
  #    ⇒ `|| echo 0` จะพิมพ์ซ้ำ ⇒ ค่ากลายเป็นสองบรรทัด "0\n0" ⇒ `[ -gt 0 ]` พัง
  #    (hook นี้ใช้ `set -u` ไม่ใช่ `set -e` ⇒ exit 1 ของ grep ไม่ทำให้หยุด)
  #    เจอเพราะเดินทางนี้จริงทั้งสองทิศ ไม่ใช่เพราะอ่านโค้ด
  KILL_TRACES="$(grep -cE 'Killed|SIGKILL|out of memory|heap out of memory|Aborted' "$BUILD_LOG" 2>/dev/null)"
  if [ "$MEM_FREE_MB" -lt "$MEM_MIN_MB" ] || [ "$KILL_TRACES" -gt 0 ]; then
    echo "   ⚠️ **อาจล้มเพราะแรมไม่พอ — ผลนี้ยังตัดสินโค้ดไม่ได้**"
    echo "      แรมว่างตอนเริ่ม build: ${MEM_FREE_MB} MB (เกณฑ์ ${MEM_MIN_MB} MB) · ร่องรอยถูกฆ่าในล็อก: ${KILL_TRACES} บรรทัด"
    echo "      ผู้ถือแรม 3 อันดับตอนนี้:"
    ps -eo rss,cmd --sort=-rss | awk 'NR>1 && NR<=4 {printf "         %6.1f GB  %.60s\n", $1/1048576, substr($0, index($0,$2))}'
    echo "      ⇒ **อย่าเพิ่งไล่หาบั๊กจากข้อความข้างล่าง** — รอให้แรมว่างแล้วรันใหม่ก่อน"
    echo "      🚫 และ **ห้ามใช้ SKIP_PREPUSH=1 เพื่อเลี่ยงข้อนี้** — ข้ามด่านไม่ได้ทำให้แรมพอ"
    echo "         มันแค่ย้ายการล้มไปที่ Netlify ซึ่งเสียเครดิตจริงและช้ากว่า"
  fi
  TREE_AFTER="$(ลายนิ้วมือ)"
  if [ "$TREE_BEFORE" != "$TREE_AFTER" ]; then
    echo "   ⚠️ **อินพุตเปลี่ยนกลางทาง — ผลนี้ตัดสินโค้ดไม่ได้**"
    echo "      ก่อน build: $TREE_BEFORE"
    echo "      หลัง build: $TREE_AFTER"
    echo "      (เราสองบัญชีใช้ clone เดียวกัน ⇒ อีกฝั่งอาจ commit/แก้ไฟล์ระหว่างที่ build วิ่ง)"
    echo "      ⇒ **อย่าเพิ่งไล่หาบั๊กจากข้อความข้างล่าง** — รัน push ใหม่ตอนที่ไม่มีใครแก้ก่อน"
    echo "      ⇒ ถ้ารันใหม่แล้วยังตก ค่อยเชื่อข้อความนั้น"
  fi
  grep -E "🛑|Failed to compile|error TS|Error:" "$BUILD_LOG" | head -5
  # วัดแล้ว 19 ก.ย. 2569: `npm run build` ที่ prebuild ตก **ไม่เติมบรรทัดท้ายของตัวเอง**
  # ⇒ บรรทัดสุดท้ายของล็อกคือของด่านที่ตกจริง · ใช้ 20 บรรทัดเผื่อด่านที่พิมพ์คำแนะนำยาว
  echo "   ── ท้ายล็อก (ด่านที่ตกอยู่ตรงนี้) ──"
  tail -20 "$BUILD_LOG" | sed 's/^/   /'
  echo "   (ผลเต็มที่ $BUILD_LOG — แยกต่อรีโปแล้ว ไม่ถูกอีกรีโปเขียนทับ)"
  exit 1
fi
echo "   ✅ npm run build ผ่าน (prebuild ครบทุกด่าน)"

# ── ด่าน promise ปล่อยลอย ──
# 🔴 **"ด่านพัง" กับ "ด่านเจอของผิด" ต้องไม่รายงานเหมือนกัน** (เจอ 19 ก.ย. 2569 ตอนจะ push จริง)
#    ของเดิมเขียน `if ! node ...` ⇒ ไฟล์ **ไม่มีอยู่จริงในรีโปนี้** (มีเฉพาะฝั่งท่อ)
#    ⇒ node ตอบ MODULE_NOT_FOUND ⇒ ด่านพิมพ์ว่า **"เจอ promise ปล่อยลอย — ไม่ push"**
#    ⇒ **คำเท็จ** และทำให้คนไปหา promise ที่ไม่มีอยู่ · ผมเสียเวลาไปหนึ่งรอบกับข้อความนี้
#    🔑 คลาสเดียวกับที่ทีมไล่ปิดกันทั้งวัน: ระบบทำงานถูก แต่สื่อสารผิด
# ⚠️ **ไม่มีด่าน ≠ ผ่านด่าน** ⇒ ข้ามได้ แต่ต้องพิมพ์ออกมาทุกครั้ง ไม่ใช่เงียบ
if [ ! -f scripts/check-floating.mjs ]; then
  echo "⚠️  ข้ามด่าน promise ปล่อยลอย — **ไม่มี scripts/check-floating.mjs ในรีโปนี้**"
  echo "    (มีเฉพาะฝั่งท่อ · รีโปนี้ยังไม่มีคนย้ายมา) ⇒ นี่คือช่องว่าง ไม่ใช่ผลผ่าน"
elif ! node scripts/check-floating.mjs > $LOGDIR/float.log 2>&1; then
  echo "❌ ด่าน promise ปล่อยลอยไม่ผ่าน — ไม่ push"
  echo "   ⚠️ อ่านข้อความข้างล่างก่อนสรุป: **ตัวด่านพังเองก็ออกมาทางนี้เหมือนกัน**"
  tail -5 $LOGDIR/float.log
  exit 1
fi

# ── ความถี่: **ห้าม** ไม่ใช่เตือน (แก้ 19 ก.ย. 2569) ──
# 🔴 **เหตุผลเดิมยังถูก แต่คำเตือนไม่ทำงาน**
#    เดิมเขียนไว้ว่า "เตือน ไม่ห้าม — วันที่ของพังจริงต้องแก้ได้ทันที"
#    ⇒ เจตนาถูก แต่ผลคือ **คำเตือนขึ้นแล้วเดินผ่าน** · นับของจริงฝั่งจอจาก reflog:
#       14 ก.ย. 30 · 15 ก.ย. 80 · 16 ก.ย. 46 · 17 ก.ย. 41 · 18 ก.ย. 55 ครั้ง
#       ⇒ อย่างน้อย **256 push ใน 6 วัน** = 256 build (หนึ่ง push = หนึ่ง build
#         ไม่ว่าจะมีกี่ commit ⇒ **commit ไม่ใช่หน่วยที่กินเครดิต**)
#    🔑 เก็บเจตนาเดิมไว้ด้วยทางด่วน: ของด่วนจริงยัง push ได้ แต่ต้อง **ตั้งใจกด**
#       ⇒ "ถี่" กลายเป็นการตัดสินใจ ไม่ใช่สิ่งที่เกิดเพราะไม่ได้อ่าน
#    (ฝั่งท่อเปลี่ยนแบบเดียวกันวันนี้ หลังเดินผ่านคำเตือนตัวเองครบ 20 รอบ)
# 🔴 **แก้ 21 ก.ย. 2569 — ด่านนี้ล็อกตัวเองจากสิ่งที่ไม่เคยเกิดขึ้น**
#    ของเดิมเขียนแสตมป์ **ตอนด่านผ่าน** ⇒ ซึ่งเกิด **ก่อน** git เริ่มส่งจริง
#    ⇒ push ที่ถูกฆ่า/ล้มกลางทาง **จุดนาฬิกา 45 นาทีทั้งที่ไม่มีอะไรถึง remote**
#    ของจริงวันนี้: ด่านบอก "เพิ่ง push ไป 4 นาที" · reflog บอกว่า push จริงล่าสุดคือ **3 ชั่วโมงก่อน**
#    ⇒ ⇒ และราคาของความผิดพลาดนี้แพง: ทุกครั้งที่ลองใหม่ = **รัน build ซ้ำ ~10 นาที**
# ✅ เปลี่ยนมาอ่านจาก **reflog ของ refs/remotes/origin/<branch>** เฉพาะรายการ `update by push`
#    ⇒ นับเฉพาะ "ของที่ถึง remote จริง" · `fetch` ไม่นับ · **ไม่มีธงในเครื่องให้เพี้ยน**
#    🔑 กติกาทั่วไป: **ตัวนับที่ต้องตอบว่า "เกิดขึ้นจริงไหม" ห้ามเขียนก่อนเหตุการณ์**
UPSTREAM_REF="$(git rev-parse --symbolic-full-name '@{u}' 2>/dev/null || echo refs/remotes/origin/main)"
NOW=$(date +%s)
GAP_MIN="${PUSH_MIN_GAP_MIN:-45}"
LAST_PUSH_AT="$(git reflog show --date=unix "$UPSTREAM_REF" 2>/dev/null \
  | grep 'update by push' | head -1 | sed -n 's/.*@{\([0-9]*\)}.*/\1/p')"
if [ -n "$LAST_PUSH_AT" ] && [ "${ALLOW_FAST_PUSH:-}" != "1" ]; then
  DIFF=$(( (NOW - LAST_PUSH_AT) / 60 ))
  if [ "$DIFF" -lt "$GAP_MIN" ]; then
    AHEAD=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo '?')
    echo "🛑 push ที่ถึง remote จริงครั้งก่อน เพิ่งผ่านไป $DIFF นาที (เกณฑ์ $GAP_MIN นาที)"
    echo "   (นับจาก reflog ของ $UPSTREAM_REF เฉพาะรายการ 'update by push' — ไม่ใช่ธงในเครื่อง)"
    echo "   ทุกครั้งที่ push = สร้างเว็บใหม่ทั้งก้อน · deploy กินเครดิต 92% ของทั้งหมด"
    echo "   ตอนนี้มี $AHEAD commit ค้างอยู่ ⇒ รอรวบแล้ว push รอบเดียวคุ้มกว่ามาก"
    echo ""
    echo "   ของด่วนจริง (ของพังอยู่บนเว็บ) ⇒ ตั้งใจกด:"
    echo "     ALLOW_FAST_PUSH=1 git push"
    echo "   ปรับเกณฑ์: PUSH_MIN_GAP_MIN=<นาที> git push"
    exit 1
  fi
fi
# 🚫 ไม่เขียนแสตมป์อีกแล้ว — รอบหน้าไปอ่าน reflog เอาเอง (ซึ่งเป็นหลักฐานหลังเหตุการณ์)

# ── ⏱️ จดของจริง (และบอกตรง ๆ ถ้าหน้าต่างปิดไประหว่างที่ด่านกำลังรัน) ──
PREPUSH_ELAPSED=$(( $(date +%s) - PREPUSH_T0 ))
PREPUSH_MIN1=$(( 10#$(date +%H) * 60 + 10#$(date +%M) ))
PREPUSH_NOTE="ปกติ"
if [ "${PREPUSH_INWIN0:-}" = "1" ] && [ -n "${PREPUSH_HI:-}" ] && [ "$PREPUSH_MIN1" -gt "$PREPUSH_HI" ]; then
  PREPUSH_NOTE="เริ่มในหน้าต่าง แต่เสร็จนอกหน้าต่าง"
  echo ""
  echo "⚠️  **หน้าต่าง push ปิดไปแล้วระหว่างที่ด่านนี้กำลังรัน**"
  echo "   เริ่มตอนอยู่ในหน้าต่าง · ด่านใช้เวลา $(( PREPUSH_ELAPSED / 60 )) นาที ⇒ ของจะขึ้นเว็บนอกรอบ"
  echo "   ⇒ **ไม่ตีกลับ** เพราะยังเป็น deploy รอบเดียว · แต่ถูกจดไว้ที่ $PREPUSH_LOG"
fi
printf '%s  %s  ใช้ %d วินาที  เริ่ม %02d:%02d เสร็จ %02d:%02d  %s\n' \
  "$(date '+%Y-%m-%d')" "$PREPUSH_REPO" "$PREPUSH_ELAPSED" \
  "$(( PREPUSH_MIN0 / 60 ))" "$(( PREPUSH_MIN0 % 60 ))" \
  "$(( PREPUSH_MIN1 / 60 ))" "$(( PREPUSH_MIN1 % 60 ))" \
  "$PREPUSH_NOTE" >> "$PREPUSH_LOG" 2>/dev/null || true

echo "✅ ผ่านด่าน — push ได้ (push จริงครั้งก่อน: ${LAST_PUSH_AT:-ไม่มีในreflog} · ด่านใช้เวลา $(( PREPUSH_ELAPSED / 60 )) นาที)"
