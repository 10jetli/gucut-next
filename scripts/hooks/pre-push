#!/bin/bash
# ด่านก่อน push — ฉบับเรียบง่าย (ท่านประธานสั่ง 12 ต.ค. 2569 "ทำให้มันเรียบง่ายแบบพื้นฐาน มันเสียเวลาแก้")
#
# 🔑 **หลักเดียว: บล็อกเฉพาะของที่พังแล้วกู้ยาก — เงิน · ข้อมูลหาย · คำสั่งท่านประธาน**
#    ที่เหลือ **พิมพ์บอกเฉย ๆ ไม่ตีกลับ**
#
# ของเดิม 322 บรรทัด · ตีกลับได้ 8 จุด ⇒ วันที่ 12 ต.ค. มันบล็อกทีมทั้งเช้าด้วยเหตุที่
# **ไม่เกี่ยวกับโค้ดเลย** (ด่านไม่ใส่ node ลง PATH ⇒ เทสเรียก npx ไม่เจอ ⇒ ล้ม ~47 ตัว)
# ⇒ ด่านที่ล้มด้วยเหตุนอกขอบเขตของมัน คือด่านที่คนจะเริ่มข้าม — แล้วมันก็ไร้ค่าไปเลย
#
# ของเดิมเก็บไว้ที่ scripts/hooks/pre-push.ยาว-ก่อน12ตค ถ้าอยากดูว่าเคยตรวจอะไรบ้าง
set -u
# 🔑 **pipefail** — ฝั่งท่อขยายคลาส "ตัวกลืนคำตัดสิน" ให้ 12 ต.ค. 2569:
#    `;` ไม่ใช่ตัวเดียวที่กลืน exit code · **pipe ก็กลืน** (ผลของ pipe = ตัวขวาสุด)
#    วันนี้ด่านนี้ไม่มี pipe บนคำตัดสิน (ที่มีคือ `grep | sed` ตอนพิมพ์ผล)
#    แต่วันที่มีคนเติม `node ด่าน.mjs | tee log` คำตัดสินจะหายเงียบ ⇒ ตั้งกันไว้ก่อน
set -o pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

# ══ ① กฎของท่านประธาน — ข้อเดียวที่ตีกลับ ═══════════════════════════════
# 🔴 ห้ามข้ามด้วยตัวแปรของเรา (SKIP_PREPUSH ข้ามได้แค่ส่วนรายงานข้างล่าง)
if [ -f "$HOME/.หยุด-deploy" ]; then
  echo "🧊 กำลังหยุด deploy อยู่ — ไม่ push"
  echo "   (ท่านประธานสั่งหยุดไว้ · ลบ ~/.หยุด-deploy เมื่อเปิดอีกครั้ง)"
  exit 1
fi

[ "${SKIP_PREPUSH:-}" = "1" ] && { echo "⏭  ข้ามรายงานตามที่สั่ง"; exit 0; }

# ══ ② ส่วนรายงาน — ไม่มีอะไรตีกลับตั้งแต่บรรทัดนี้ลงไป ═══════════════════
# 🔑 หา node ที่รันเทสได้ แล้ว **ใส่ลง PATH ด้วย**
#    (ไม่ใส่ = ลูกที่เทสเรียกเอง เช่น `npx tsc` หาไม่เจอ — ต้นเหตุของวันที่ 12 ต.ค.)
N=""
for c in "${NODE_FOR_TESTS:-}" node "$HOME"/.nvm/versions/node/*/bin/node \
         /opt/homebrew/bin/node /usr/local/bin/node; do
  [ -n "$c" ] && command -v "$c" >/dev/null 2>&1 || [ -x "$c" ] || continue
  v="$("$c" -p 'process.versions.node' 2>/dev/null)" || continue
  case "$v" in 2[2-9].*|[3-9][0-9].*) N="$c"; break ;; esac
done

if [ -z "$N" ]; then
  echo "ℹ️  ไม่พบ node ≥22 ⇒ ข้ามการตรวจ (ไม่ตีกลับ)"
  exit 0
fi
export PATH="$(dirname "$N"):$PATH"

LOG="/tmp/prepush-$(basename "$PWD").log"
echo "🔎 กำลังตรวจ (ไม่บล็อก · ผลเต็มที่ $LOG)"

# ลายนิ้วมือของสิ่งที่กำลังถูกตรวจ — HEAD + สภาพไฟล์ทั้งหมด (รวมที่ยังไม่ commit)
ลายนิ้วมือ() { printf '%s|%s' "$(git rev-parse HEAD)" "$(git status --porcelain | md5sum | cut -d' ' -f1)"; }
TREE0="$(ลายนิ้วมือ)"

TESTS=ผ่าน
if "$N" --experimental-test-module-mocks --test scripts/tests/*.test.mjs > "$LOG" 2>&1; then
  grep -E '^# (tests|pass|fail)' "$LOG" | sed 's/^/   /'
else
  TESTS=ตก
  echo "   ⚠️  ชุดทดสอบไม่ผ่าน — **ของขึ้นไปแล้ว ให้ตามแก้**"
  grep -E '^not ok' "$LOG" | head -8 | sed 's/^/   /'
  echo "   (ผลเต็ม: $LOG)"
fi

# ══ ③ build — **ใส่กลับเพราะกติกาที่เขียนไว้พึ่งมันอยู่** (12 ต.ค. 2569) ═══════
# 🔴 ตอนตัดด่านเหลือ 53 บรรทัด `npm run build` หายไปด้วย (เดิมมี 5 จุด)
#    แต่ `CLAUDE.md` ข้อ 10 เขียนว่า **"เลิกรัน npm run build ในเครื่อง เพราะ hook รันเต็มอยู่แล้ว"**
#    ⇒ กฎนั้นกลายเป็นเท็จทันที และมันบอกให้คน **เลิกป้องกัน** โดยอ้างของที่ไม่มีแล้ว
#    ⇒ ของพังจะไปตกที่ Netlify แทน = **เผาเครดิต** ซึ่งเป็นเหตุผลที่ด่านนี้เกิดมาตั้งแต่แรก
# 🔑 **ไม่ตีกลับ** ตามคำสั่งท่านประธาน — ท่านบ่นเรื่อง *การตีกลับ* ไม่ใช่ *การรายงาน*
BUILD_LOG="${LOG%.log}-build.log"
BUILD=ผ่าน
if NEXT_DIST_DIR="${NEXT_DIST_DIR:-.next-verify}" npm run build > "$BUILD_LOG" 2>&1; then :; else
  BUILD=ตก
fi

TREE_MOVED=0
เตือนถ้าต้นไม้ขยับ() {
  _after="$(ลายนิ้วมือ)"
  [ "$TREE0" = "$_after" ] && return 0
  TREE_MOVED=1
  echo "   ⚠️ ต้นไม้เปลี่ยนระหว่างด่านวิ่ง ⇒ ผลข้างบนไม่ได้ตัดสินของที่กำลังจะ push ทั้งหมด"
  git log --format="      %h %s%n        %(trailers:key=Claude-Session,valueonly=true)" \
    "${TREE0%%|*}..HEAD" 2>/dev/null || true
}
เตือนถ้าต้นไม้ขยับ

# 🔑 **ผล build ต้องอยู่ใน 5 บรรทัดท้าย** — คำเตือนกลางเอาต์พุตไม่มีใครเห็น
if [ "$BUILD" = ตก ]; then
  echo "   🔴 **npm run build ตก — ของกำลังขึ้นไปทั้งที่ build ไม่ผ่าน**"
  grep -E '🛑|Failed to compile|error TS|Error:' "$BUILD_LOG" | head -4 | sed 's/^/      /'
  echo "      (ผลเต็ม: $BUILD_LOG)"
fi

# 🔑 **บรรทัดสุดท้ายห้ามเขียนว่า "ผ่านด่าน" เฉย ๆ — ต้องบอกขอบเขตที่ตรวจ**
#    ไม่งั้นมันซื้อความมั่นใจโดยไม่ได้จ่ายการป้องกันคืน (ใบ a-half-safe-tool-consumes-all-of-our-caution)
# 🔴 **ต้นไม้ขยับ = คำตัดสินเป็นโมฆะ ไม่ใช่แค่ "มีหมายเหตุ"** (เพิ่ม 14 ต.ค. 2569 · เจอของจริงสองทิศในวันเดียว)
#    ทิศ ① เขียวลวง: commit ใหม่ลอดไปถึงปลายทางทั้งที่ด่านตรวจ sha เก่า (6 ต.ค. · 14 ต.ค.)
#    ทิศ ② **แดงลวง**: ของที่ยังไม่ commit ทำให้ build ตก ⇒ ด่านพิมพ์ "เทส=ตก · build=ตก · ของขึ้นไปแล้ว"
#         ทั้งที่คอมมิตที่ push ไปไม่มีปัญหา (14 ต.ค. 10:4x — ผมเอง) ⇒ คนอ่านจะวิ่งหาไฟที่ไม่มีอยู่
#    ⇒ เขียนให้ชัดว่า **ผลนี้เป็นของส่วนผสม** และ **ที่ต้องไปดูคือผล build ที่ปลายทาง**
if [ "$TREE_MOVED" = 1 ]; then
  echo "⚠️ ด่านจบ แต่ **ผลนี้ไม่ตัดสินของที่ push** — ต้นไม้ขยับระหว่างด่านวิ่ง"
  echo "   (เทส=$TESTS · build=$BUILD เป็นผลของ **ส่วนผสม** ระหว่างของที่ commit แล้วกับของที่ยังไม่ commit)"
  echo "   ⇒ แดงอาจมาจากของที่ยังไม่ commit · เขียวอาจไม่ได้ตรวจคอมมิตที่ลอดไป"
  echo "   ⇒ **ตัดสินจากผล build ที่ปลายทางเท่านั้น** (ดูช่อง deploy)"
elif [ "$TESTS" = ตก ] || [ "$BUILD" = ตก ]; then
  # 🔴 **ห้ามขึ้น ✅ ตอนมีอะไรตก** (เพิ่ม 14 ต.ค. 2569 — ของจริงของผมเอง)
  #    ของเดิมพิมพ์ "✅ ด่านจบ (ตรวจ: เทส=ตก · build=ผ่าน …)" ⇒ **ผมอ่านแล้วพลาดเอง**
  #    เห็นเครื่องหมายถูกหน้าบรรทัด + คำว่า build=ผ่าน แล้วปล่อย push ขึ้นไปทั้งที่เทสตก 1 ข้อ
  #    🔑 ฝั่งท่อชี้ข้อที่ถูก: **คนจะอ่านบรรทัดท้าย** ⇒ ต้องออกแบบรอบข้อเท็จจริงนั้น
  #       ไม่ใช่สั่งให้คนอ่านทั้งหน้า ⇒ บรรทัดท้ายต้อง **ขึ้นต้นด้วยผลรวม** ไม่ใช่ด้วยเครื่องหมายถูก
  echo "🔴 ด่านจบ แต่ **มีของตก** (เทส=$TESTS · build=$BUILD) — ของขึ้นไปแล้ว ให้ตามแก้"
  echo "   ⇒ ด่านนี้ไม่ตีกลับ ⇒ **ความรับผิดชอบอยู่ที่คนอ่านบรรทัดนี้** · ผลเต็ม: $LOG"
else
  echo "✅ ด่านจบ (ตรวจ: เทส=$TESTS · build=$BUILD · ลายนิ้วมือต้นไม้) · **ด่านนี้ไม่ตีกลับ ยกเว้นธงหยุด deploy**"
fi
exit 0
