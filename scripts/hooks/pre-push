#!/bin/bash
# ด่านก่อน push — ฉบับเรียบง่าย (ท่านประธานสั่ง 12 ต.ค. 2569 "ทำให้มันเรียบง่ายแบบพื้นฐาน มันเสียเวลาแก้")
#
# 🔑 **หลักเดียว: บล็อกเฉพาะของที่พังแล้วกู้ยาก — เงิน · ข้อมูลหาย · คำสั่งท่านประธาน**
#    ที่เหลือ **พิมพ์บอกเฉย ๆ ไม่ตีกลับ**
#
# ของเดิม 322 บรรทัด · ตีกลับได้ 8 จุด ⇒ วันที่ 12 ต.ค. มันบล็อกทีมทั้งเช้าด้วยเหตุที่
# **ไม่เกี่ยวกับโค้ดเลย** (ด่านไม่ใส่ node ลง PATH ⇒ เทสเรียก npx ไม่เจอ ⇒ ล้ม ~47 ตัว)
# ⇒ ด่านที่ล้มด้วยเหตุนอกขอบเขตของมัน คือด่านที่คนจะเริ่มข้าม — แล้วมันก็ไร้ค่าไปเลย
#
# ของเดิมเก็บไว้ที่ scripts/hooks/pre-push.ยาว-ก่อน12ตค ถ้าอยากดูว่าเคยตรวจอะไรบ้าง
set -u
cd "$(git rev-parse --show-toplevel)" || exit 0

# ══ ① กฎของท่านประธาน — ข้อเดียวที่ตีกลับ ═══════════════════════════════
# 🔴 ห้ามข้ามด้วยตัวแปรของเรา (SKIP_PREPUSH ข้ามได้แค่ส่วนรายงานข้างล่าง)
if [ -f "$HOME/.หยุด-deploy" ]; then
  echo "🧊 กำลังหยุด deploy อยู่ — ไม่ push"
  echo "   (ท่านประธานสั่งหยุดไว้ · ลบ ~/.หยุด-deploy เมื่อเปิดอีกครั้ง)"
  exit 1
fi

[ "${SKIP_PREPUSH:-}" = "1" ] && { echo "⏭  ข้ามรายงานตามที่สั่ง"; exit 0; }

# ══ ② ส่วนรายงาน — ไม่มีอะไรตีกลับตั้งแต่บรรทัดนี้ลงไป ═══════════════════
# 🔑 หา node ที่รันเทสได้ แล้ว **ใส่ลง PATH ด้วย**
#    (ไม่ใส่ = ลูกที่เทสเรียกเอง เช่น `npx tsc` หาไม่เจอ — ต้นเหตุของวันที่ 12 ต.ค.)
N=""
for c in "${NODE_FOR_TESTS:-}" node "$HOME"/.nvm/versions/node/*/bin/node \
         /opt/homebrew/bin/node /usr/local/bin/node; do
  [ -n "$c" ] && command -v "$c" >/dev/null 2>&1 || [ -x "$c" ] || continue
  v="$("$c" -p 'process.versions.node' 2>/dev/null)" || continue
  case "$v" in 2[2-9].*|[3-9][0-9].*) N="$c"; break ;; esac
done

if [ -z "$N" ]; then
  echo "ℹ️  ไม่พบ node ≥22 ⇒ ข้ามการตรวจ (ไม่ตีกลับ)"
  exit 0
fi
export PATH="$(dirname "$N"):$PATH"

LOG="/tmp/prepush-$(basename "$PWD").log"
echo "🔎 กำลังตรวจ (ไม่บล็อก · ผลเต็มที่ $LOG)"

if "$N" --experimental-test-module-mocks --test scripts/tests/*.test.mjs > "$LOG" 2>&1; then
  grep -E '^# (tests|pass|fail)' "$LOG" | sed 's/^/   /'
else
  echo "   ⚠️  ชุดทดสอบไม่ผ่าน — **ของขึ้นไปแล้ว ให้ตามแก้**"
  grep -E '^not ok' "$LOG" | head -8 | sed 's/^/   /'
  echo "   (ผลเต็ม: $LOG)"
fi

exit 0
