#!/bin/bash
# ด่านตอนพิมพ์: **ห้าม commit ขณะด่านก่อน push ของกิ่งนี้กำลังวิ่ง**
#
# 🔴 เหตุ (ของจริง 14 ต.ค. 2569 — ผมเหยียบสองครั้งในวันเดียว ทั้งที่มีใบบทเรียนห้ามไว้แล้ว)
#    commit ใหม่ระหว่างด่าน push วิ่ง ทำให้ผลของด่าน **เป็นของส่วนผสม** ⇒ ผิดได้สองทิศ:
#      ① **เขียวลวง** — ก้อนใหม่ลอดไปถึงปลายทางทั้งที่ด่านตรวจ sha เก่า (6 ต.ค. · 14 ต.ค.)
#      ② **แดงลวง**  — ของที่ยังไม่ commit ทำให้ build ตก ⇒ ด่านบอกว่าของที่ push ไปพัง
#                      ทั้งที่ไม่พัง ⇒ คนวิ่งหาไฟที่ไม่มีอยู่
# 🔑 **ใบบทเรียนห้ามไว้ก่อนแล้วทั้งสองครั้ง และยังเหยียบ** ⇒ คุณค่าของใบอยู่ที่
#    **มีด่านตัวไหนยืนขวาง และยืนตอนไหน** — ใบที่ไม่มีด่านตอนพิมพ์จะถูกเหยียบก่อนเสมอ
#
# ทางออกเมื่อจำเป็น: `ALLOW_COMMIT_DURING_PUSH=1 git commit …`
#    หรือ (ที่แนะนำ) **commit บนกิ่งอื่น** แล้วค่อยย้ายมาเมื่อด่านจบ
set -u
FLAG="${GUCUT_PREPUSH_FLAG:-$HOME/.gucut-prepush-running}"
[ -f "$FLAG" ] || exit 0
[ "${ALLOW_COMMIT_DURING_PUSH:-}" = "1" ] && { echo "⚠️ commit ระหว่างด่าน push วิ่ง — ข้ามตามที่สั่ง"; exit 0; }

FLAG_REPO="$(sed -n '1p' "$FLAG" 2>/dev/null)"
FLAG_SHA="$(sed -n '2p' "$FLAG" 2>/dev/null)"
FLAG_AT="$(sed -n '3p' "$FLAG" 2>/dev/null)"
HERE="$(git rev-parse --show-toplevel 2>/dev/null)"

# 🔑 ธงของรีโปอื่น ไม่เกี่ยวกับ commit นี้ (เครื่องนี้มีสองรีโป)
[ "$FLAG_REPO" = "$HERE" ] || exit 0

# ⏳ ธงเก่าเกินสองชั่วโมง = น่าจะค้างจากรอบที่ถูกฆ่า ⇒ **เตือนแต่ไม่บล็อก**
#    (ด่านที่บล็อกด้วยของค้าง คือด่านที่คนจะถอด — และ trap EXIT ควรลบให้แล้ว)
NOW="$(date +%s)"
if [ -n "$FLAG_AT" ] && [ $((NOW - FLAG_AT)) -gt 7200 ]; then
  echo "⚠️ เจอธง \"ด่านกำลังวิ่ง\" แต่เก่ากว่า 2 ชม. ⇒ ถือว่าเป็นธงค้าง **ไม่บล็อก**"
  echo "   ⇒ ถ้าไม่มีด่านวิ่งอยู่จริง ลบทิ้งได้: rm $FLAG"
  exit 0
fi

echo "🛑 **ด่านก่อน push ของกิ่งนี้กำลังวิ่งอยู่ — ยังไม่ commit**"
echo "   ด่านเริ่มตรวจที่ HEAD = ${FLAG_SHA:0:8} · commit ตอนนี้จะทำให้ผลของด่านเป็น **ส่วนผสม**"
echo "   ⇒ เขียวลวง: ก้อนใหม่อาจลอดไปถึงปลายทางทั้งที่ด่านไม่ได้ตรวจ"
echo "   ⇒ แดงลวง: ด่านอาจรายงานว่าของที่ push ไปพัง ทั้งที่ของที่พังคือของที่ยังไม่ commit"
echo "   🔑 ทางที่แนะนำ: **commit บนกิ่งอื่น** แล้วย้ายมาเมื่อด่านจบ"
echo "   ⏭️  ถ้ายืนยันจริง: ALLOW_COMMIT_DURING_PUSH=1 git commit …"
exit 1
